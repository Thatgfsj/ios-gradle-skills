{
  "project": "BasicApp",
  "platform": "ios",
  "github": {
    "owner": "YOUR_GITHUB_USER",
    "repo": "YOUR_REPO"
  },
  "ios": {
    "path": ".",
    "scheme": "BasicApp",
    "bundleId": "com.example.basicapp",
    "configuration": "Debug",
    "signing": false
  },
  "mobai": {
